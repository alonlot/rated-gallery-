<?xml version="1.0" encoding="utf-8"?>
<!-- The PC is on the LAN, plain HTTP, its IP is unknown at build time. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
